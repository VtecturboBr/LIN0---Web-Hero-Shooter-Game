{
  "name": "lin0-hero-shooter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LIN0 — protótipo de hero shooter com Three.js, TypeScript e Vite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
